# .env_sample
# This file provides a template for required environment variables.
# Copy it to .env and fill in the actual values before running docker-compose.

# Development mode - bypass Firebase authentication (set to true for local development)
DEV_MODE=true

# URL prefix for reverse proxy (empty for local, "/store" for Cloud Run)
URL_PREFIX=

# SQLite database URL (default works for local development)
DATABASE_URL=sqlite:///./test.db

# Google Gemini / Vertex AI API key – replace with your actual key.
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_GENAI_USE_VERTEXAI=0

# OpenAI API key for GPT-4o (Multi-Model Judge Panel)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Anthropic API key for Claude Haiku 4.5 (Multi-Model Judge Panel)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Weights & Biases Configuration (for MCP integration)
WANDB_API_KEY=YOUR_WANDB_API_KEY
WANDB_PROJECT=agent-store-sandbox
WANDB_ENTITY=your-entity
WANDB_BASE_URL=https://api.wandb.ai

# Security Gate Configuration
# Maximum number of security prompts to execute (default: 10, production: 50-100)
SECURITY_GATE_MAX_PROMPTS=10
# Timeout in seconds for each prompt execution
SECURITY_GATE_TIMEOUT=10.0
# Wait time between prompts (rate limit protection)
SECURITY_GATE_THROTTLE_SECONDS=1.0
# Number of samples from AdvBench dataset
ADVBENCH_MAX_SAMPLES=10

# Agent Card Accuracy Configuration
# Enable multi-turn dialogue evaluation (default: true)
FUNCTIONAL_USE_MULTITURN=true
# Maximum conversation turns for multi-turn evaluation (default: 5)
FUNCTIONAL_MAX_TURNS=5
# Maximum number of scenarios to test (for testing, default: all scenarios)
FUNCTIONAL_MAX_SCENARIOS=3

# Jury Judge Configuration (Collaborative Evaluation Framework)
# Enable collaborative jury judge (default: true)
JURY_USE_COLLABORATIVE=true
# Maximum discussion turns - continuous conversation until consensus (default: 9, 3 jurors x 3 turns each)
JURY_MAX_DISCUSSION_TURNS=9
# Consensus threshold - IMPORTANT: Set > 1.0 to FORCE discussion phase even on unanimous agreement
#   - 2.0 with 3 jurors = ALWAYS execute Phase 2 (impossible to reach 2.0 naturally)
#   - 1.0 = unanimous (3/3) allows early termination, majority (2/3) requires discussion
#   - 0.67 = majority (2/3) allows early termination
JURY_CONSENSUS_THRESHOLD=2.0
# Final judgment method: majority_vote, weighted_average, final_judge
# Final judge model (used only if method=final_judge)
JURY_FINAL_JUDGE_MODEL=gemini-2.5-pro

# Auto Decision Thresholds
# Trust Score >= AUTO_APPROVE_THRESHOLD: auto_approved (default: 90)
# Trust Score <= AUTO_REJECT_THRESHOLD: auto_rejected (default: 50)
# Otherwise: requires_human_review
AUTO_APPROVE_THRESHOLD=90
AUTO_REJECT_THRESHOLD=50

# Firebase Authentication
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# GCP / Cloud Run Deployment
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-northeast1
SERVICE_NAME=secure-mediation-a2a-platform
